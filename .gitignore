# ==========================================
# .gitignore for .NET Core Web APIs & Blazor
# ==========================================

# ------------------------------------------
# Build & Output Directories
# ------------------------------------------
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
[Tt]emp/
[Tt]mp/
publish/
pkg/

# ------------------------------------------
# User-Specific & IDE Files
# ------------------------------------------
# Visual Studio
.vs/
*.user
*.userossc
*.sln.docstates
*.suo
*.userprefs

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains Rider
.idea/
*.sln.iml

# ------------------------------------------
# .NET / C# Tooling & Artifacts
# ------------------------------------------
*.cache
*.docstates
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

# .NET Core local tool manifest / store
.config/dotnet-tools.json

# ------------------------------------------
# Entity Framework Core & Local DBs
# ------------------------------------------
*.mdf
*.ldf
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

# ------------------------------------------
# Secrets, Environment & Configuration
# ------------------------------------------
appsettings*.Development.json
appsettings*.Local.json
*.env
*.env.local
*.env.development
secrets.json

# ------------------------------------------
# Docker & Kubernetes Local Overrides
# ------------------------------------------
docker-compose.override.yml
.k8s/local/
*.user.yaml

# ------------------------------------------
# Frontend & Blazor Static Web Assets
# ------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Blazor CSS Isolation / Bundle generated files
wwwroot/css/app.min.css
wwwroot/dist/

# ------------------------------------------
# OS / System Files
# ------------------------------------------
.DS_Store
.DS_Store?
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------
# Testing & Coverage Reports
# ------------------------------------------
TestResults/
*.trx
*.coverage
*.coveragexml
coverage/